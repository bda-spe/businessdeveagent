# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Server ---
PORT=8080
NODE_ENV=development
# Public URL of this API once deployed (used in emails + Stripe webhook URL).
APP_BASE_URL=http://localhost:8080
# Comma-separated extra origins allowed for credentialed (cookie) CORS.
ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Supabase: Project Settings -> Database -> Connection string -> URI (use the
# "Session pooler" URI for local dev). Neon: Dashboard -> Connection Details.
DATABASE_URL=

# --- Object storage (S3-compatible) ---
# Supabase: Project Settings -> Storage -> S3 Connection. Create a bucket
# named "bda-uploads" (Storage -> New bucket) before running the app.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=bda-uploads
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- AI ---
OPENAI_API_KEY=

# --- Billing (Stripe dashboard -> Developers -> API keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MONTHLY_PRICE_ID=
YEARLY_PRICE_ID=
SETUP_FEE_PRICE_ID=

# --- Email (SMTP) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Logging ---
LOG_LEVEL=info
