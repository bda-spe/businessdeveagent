    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "stripe": "^22.3.0",
    "svg-to-pdfkit": "^0.1.8"
