# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# These are Vite build-time vars — VITE_-prefixed ones ARE bundled into the
# public client JS, which is expected: they're publishable/public keys, not secrets.

PORT=5173
BASE_PATH=/

# Absolute URL of the API server. Local dev: http://localhost:8080
# (matching api-server's PORT). Production: your Render URL.
VITE_API_BASE_URL=

VITE_STRIPE_PUBLISHABLE_KEY=
